---
title: Blog
permalink: /blog/
---
<h1 class="page-title">Blog</h1>

{%- for group in collections.posts | groupByYear %}
<section class="year">
  <h2>{{ group.year }}</h2>
  <ul class="post-list">
    {%- for post in group.posts %}
    {%- set pics = collections.photos | photosOfPost(post.url) %}
    <li>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | shortDate }}</time>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      {%- if pics.length %}<span class="post-list__count" title="{{ pics.length }} photos">{{ pics.length }} photo{% if pics.length > 1 %}s{% endif %}</span>{% endif %}
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endfor %}
