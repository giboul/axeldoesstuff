---
permalink: /
bodyClass: home
---
<section class="intro">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}</p>
</section>

<section class="home-section">
  <div class="section-head">
    <h2>Photos récentes</h2>
    <a href="/gallery/">Toutes les photos →</a>
  </div>
  <div class="grid grid--small">
    {%- for photo in collections.photos | head(10) %}{% galleryThumb photo %}{% endfor %}
  </div>
</section>

<section class="home-section">
  <div class="section-head">
    <h2>Articles récents</h2>
    <a href="/blog/">Tous les articles →</a>
  </div>
  <ul class="cards">
    {%- for post in collections.posts | head(4) %}
    {%- set cover = (collections.photos | photosOfPost(post.url))[0] %}
    <li class="card">
      <a href="{{ post.url }}">
        {%- if cover %}<div class="card__img">{% coverImage cover %}</div>{% endif %}
        <div class="card__body">
          <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.inputPath | excerpt(24) }}</p>
        </div>
      </a>
    </li>
    {%- endfor %}
  </ul>
</section>
