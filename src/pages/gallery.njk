---
title: Galerie
permalink: /gallery/
mainClass: wrap wrap--wide
---
<div class="gallery-head">
  <h1 class="page-title">Galerie</h1>
  <form class="search" role="search" onsubmit="return false">
    <label for="q" class="visually-hidden">Rechercher dans les photos</label>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="m21 21-4.3-4.3M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"/></svg>
    <input id="q" type="search" placeholder="Rechercher un nom, une légende, un texte d'article, un mois…" autocomplete="off">
  </form>
  {%- set allTags = [] %}
  {%- for photo in collections.photos %}{% for t in photo.tags %}{% if not (t in allTags) %}{% set allTags = (allTags.push(t), allTags) %}{% endif %}{% endfor %}{% endfor %}
  <div class="chips" aria-label="Thèmes">
    {%- for t in allTags | sort %}<button type="button" class="chip" data-tag="{{ t }}">{{ t }}</button>{% endfor %}
  </div>
  <p class="count" aria-live="polite"><span id="count">{{ collections.photos.length }}</span> photos<span id="filter-note"></span></p>
</div>

<div class="grid" id="grid">
  {%- for photo in collections.photos %}{% galleryThumb photo %}{% endfor %}
</div>
<p class="empty" id="empty" hidden>Aucune photo ne correspond à cette recherche.</p>

<script>
(function () {
  var input = document.getElementById("q");
  var thumbs = Array.prototype.slice.call(document.querySelectorAll("#grid .thumb"));
  var chips = Array.prototype.slice.call(document.querySelectorAll(".chip"));
  var count = document.getElementById("count");
  var empty = document.getElementById("empty");
  var note = document.getElementById("filter-note");
  var params = new URLSearchParams(location.search);
  var post = params.get("post");

  function apply() {
    var terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    var shown = 0;
    thumbs.forEach(function (el) {
      var hay = el.dataset.search;
      var ok = terms.every(function (t) { return hay.indexOf(t) !== -1; });
      if (post) ok = ok && (" " + el.dataset.posts + " ").indexOf(" " + post + " ") !== -1;
      el.hidden = !ok;
      if (ok) shown++;
    });
    count.textContent = shown;
    empty.hidden = shown !== 0;
    chips.forEach(function (c) { c.setAttribute("aria-pressed", terms.indexOf(c.dataset.tag.toLowerCase()) !== -1); });
    var url = new URL(location.href);
    if (input.value.trim()) url.searchParams.set("q", input.value.trim()); else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  if (post) {
    note.innerHTML = ' d\'un seul article · <a href="{{ '/gallery/' | url }}">tout afficher</a>';
  }
  input.value = params.get("q") || "";
  input.addEventListener("input", apply);
  chips.forEach(function (c) {
    c.addEventListener("click", function () {
      var tag = c.dataset.tag.toLowerCase();
      var terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      terms = terms.indexOf(tag) !== -1 ? terms.filter(function (t) { return t !== tag; }) : terms.concat(tag);
      input.value = terms.join(" ");
      apply();
    });
  });
  apply();
})();
</script>
